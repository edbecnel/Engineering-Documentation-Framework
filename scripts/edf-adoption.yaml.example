# EDF Adoption Configuration
#
# Copy this file to your project root as edf-adoption.yaml when adopting EDF.
# Scripts read profile from this file when --profile is not passed on the command line.
#
# For multi-discipline projects, prefer edf-project-context.yaml (see capabilities/project-context.schema.yaml)
# See: docs/Development/Profile_Aware_Bootstrap.md

# Legacy domain profile: core (default when ambiguous) or software-engineering
profile: core

# Human-readable project name (informational; used in adoption reports)
project_name: My Project

# Whether to copy the full AI handbook from EDF during bootstrap (documentation only;
# not yet implemented as an automated script option — copy manually or via AI playbook)
copy_ai_handbook: false
